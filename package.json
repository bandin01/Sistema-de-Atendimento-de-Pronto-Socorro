{
  "name": "pronto-socorro-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Back-end do Sistema de Atendimento de Pronto-Socorro (Projeto Integrador 2)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "seed": "node src/db/seeds/seedDesenvolvimento.js",
    "seed:demo": "node src/db/seeds/seedDesenvolvimento.js --demo",
    "test:smoke": "node testes/smoke_api.mjs",
    "test:stress": "node testes/stress_concorrencia.mjs",
    "migrate": "node src/db/migrar.js",
    "migrate:status": "node src/db/migrar.js --status",
    "migrate:baseline": "node src/db/migrar.js --baseline",
    "test:migracoes": "node --test testes/migracoes.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
