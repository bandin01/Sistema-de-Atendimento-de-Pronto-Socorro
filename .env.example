# Copie para .env e preencha. Nunca versione o .env.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pronto_socorro
DB_CONNECTION_LIMIT=10

# Origem(ns) do front-end, separadas por vírgula. localhost e 127.0.0.1 são origens diferentes.
CORS_ORIGIN=http://127.0.0.1:5500

# Obrigatório, mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# 10 em produção. Pode baixar para 4 só em testes automatizados.
BCRYPT_ROUNDS=10
